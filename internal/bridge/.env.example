# Скопируйте в tds/internal/bridge/.env и заполните локально. Файл .env не коммитится.

# Адрес трекера без пути /admin_api.
KEITARO_BASE_URL=

# Ключ Admin API. В репозиторий и в логи не попадает.
KEITARO_API_KEY=

# Локальная админка kuztds.
KUZTDS_ADMIN_URL=http://127.0.0.1:8090
KUZTDS_ADMIN_USER=admin
KUZTDS_ADMIN_PASSWORD=
