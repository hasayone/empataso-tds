# Built-in User-Agent signatures. One lowercase substring per line, matched
# case-insensitively anywhere in the User-Agent. The section header sets the label:
#   [headless]         automated browsers
#   [http_client]      libraries and command-line clients, counted always
#   [http_client_bare] libraries counted only when the UA has no "mozilla/"
#   [crawler]          crawlers, SEO tools, AI agents and link-preview fetchers
#   [scanner]          vulnerability and network scanners
# Generic words (bot, spider, crawler, safari, wv, instagram, fban, telegram, sogou)
# are deliberately absent: they appear in real visitor UAs.
# signature_ua.dat in the data directory extends this set; a line "-pattern" there
# disables the built-in pattern with the same text.

[headless]
headlesschrome
phantomjs
puppeteer
playwright
selenium
webdriver
chrome-lighthouse
slimerjs
htmlunit
zombie.js

