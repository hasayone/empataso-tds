# Скопируйте в .env и заполните локально. Файл .env не коммитится.
# Логин админки по умолчанию: admin.

# Локальный пароль админки. Логин: admin. Образ считает argon2id-хэш при старте.
# Пустое значение открывает форму первого входа (задать пароль в браузере).
EMTDS_ADMIN_PASSWORD=admin

# Пароль пользователя ClickHouse. База и пользователь называются kuztds
# намеренно: при переименовании в EmTDS их не меняли, чтобы не терять данные.
CLICKHOUSE_PASSWORD=

# Постбеки: ключ для маршрута /{EMTDS_POSTBACK_SECRET}/postback и параметра ?key=.
# Не путать с EMTDS_POSTBACK_KEY старого пикселя /?pb=.
# EMTDS_POSTBACK_AUTH: compat (пусто = compat) — принимает без ключа; require — 403 без верного ключа.
EMTDS_POSTBACK_SECRET=
EMTDS_POSTBACK_AUTH=
