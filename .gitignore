# Binaries
/bin/
dist/
*.exe
emtds-engine
emtds-admin
# command binaries built by go build ./cmd/<name> without -o
/engine
/admin
/apiclient
/cron

# Local configs and secrets (DO NOT commit)
*.local.yaml
*.env
.env
secrets/
access.txt
# cron service config (holds the bot token and API keys) and its state
cron.json
cron.json.*

# Data (do not version large/sensitive files)
/data/
*.mmdb
*.dat
*.db
*.db-wal
*.db-shm
# state files of the Keitaro transfer job written to the working directory
/.keitaro-job*-result.json

# Go
/vendor/
*.test
*.out
coverage.*

# IDE / OS
.idea/
.vscode/
.DS_Store

# test geo database (needed by tests)
!internal/geo/testdata/*.mmdb
# built-in proxy org list compiled into the engine (data/proxy_org.dat stays ignored)
!internal/detect/proxy_org.dat
!internal/detect/signature_ua_default.dat
